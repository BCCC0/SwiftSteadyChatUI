# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode / build artifacts
xcuserdata/
DerivedData/
*.xcuserstate
build/
*.ipa
*.dSYM
*.dSYM.zip

# SwiftPM
/.build
/Packages
.swiftpm/*
!.swiftpm/xcode/
.swiftpm/xcode/*
!.swiftpm/xcode/xcshareddata/
.swiftpm/xcode/package.xcworkspace/xcuserdata/

# Note: the negations above keep `.swiftpm/xcode/xcshareddata/` trackable so
# the committed shared package scheme (SwiftSteadyChatUI.xcscheme) is not
# swallowed by the `.swiftpm/*` ignore. Without it CI's xcodebuild would
# auto-generate a scheme and could silently run 0 Swift Testing tests.

# xcodegen-generated sample project (regenerate with `make generate-sample-project`)
*.xcodeproj/

# Demo videos (regenerate with `./scripts/record-demo.sh`). The final mp4s are
# committed (README embeds them); only the raw recordings + trim temps are ignored.
/demo/*
!/demo/*.mp4

# Internal superpowers docs + agent context (never tracked; repo hooks also forbid them)
/docs/
/CLAUDE.md

# Credentials
.netrc
